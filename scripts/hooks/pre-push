#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook: DCO gate — block pushing any commit whose Signed-off-by
# trailer does not match its author, BEFORE it reaches GitHub. Mirrors the
# ranges that .github/workflows/dco.yml checks server-side; the rules live
# in scripts/check-dco.sh and are shared by both.
#
# Activated automatically via scripts/setup.sh or manually:
#   git config core.hooksPath scripts/hooks
#
# stdin (one line per pushed ref): <local ref> <local sha> <remote ref> <remote sha>

ZERO=0000000000000000000000000000000000000000
FAIL=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Branch/tag deletion carries no new commits.
    if [ "$local_sha" = "$ZERO" ]; then
        continue
    fi

    if [ "$remote_sha" != "$ZERO" ]; then
        RANGE="$remote_sha..$local_sha"
    else
        # New ref: check the commits not yet on the default branch, exactly
        # like dco.yml does for first pushes.
        BASE=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo "origin/main")
        if ! git rev-parse --verify --quiet "$BASE" >/dev/null; then
            echo "pre-push DCO: no $BASE locally — cannot determine range for $local_ref, skipping"
            continue
        fi
        RANGE="$BASE..$local_sha"
    fi

    echo "pre-push DCO: checking $local_ref ($RANGE)"
    if ! scripts/check-dco.sh "$RANGE"; then
        FAIL=1
    fi
done

if [ "$FAIL" -ne 0 ]; then
    echo "pre-push: DCO gate blocked the push — sign off the commits above and retry" >&2
    exit 1
fi
