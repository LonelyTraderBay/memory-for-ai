# Maintainer: LonelyTraderBay <https://github.com/LonelyTraderBay>
pkgname=memory-for-ai
pkgver=0.11.0
pkgrel=1
pkgdesc="Fast code intelligence engine for AI coding agents — single static binary MCP server"
arch=('x86_64' 'aarch64')
url="https://github.com/LonelyTraderBay/memory-for-ai"
license=('MIT')
provides=("$pkgname")
conflicts=("$pkgname")

source_x86_64=("${pkgname}-${pkgver}-linux-amd64.tar.gz::https://github.com/LonelyTraderBay/memory-for-ai/releases/download/v${pkgver}/memory-for-ai-linux-amd64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-linux-arm64.tar.gz::https://github.com/LonelyTraderBay/memory-for-ai/releases/download/v${pkgver}/memory-for-ai-linux-arm64.tar.gz")

sha256sums_x86_64=('1b5234d0d3cb086cfc56dd0faf374abb9b388ad3222b5302a74f070aa94c5e87')
sha256sums_aarch64=('54e405819cbd22b0810374ab6bd65c97a721ab7dde4a630166bc0ed90f327803')

package() {
    install -Dm755 "${srcdir}/memory-for-ai" \
        "${pkgdir}/usr/bin/memory-for-ai"
    install -Dm644 "${srcdir}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    # Third-party attribution bundle (present in archives since v0.8.1)
    if [ -f "${srcdir}/THIRD_PARTY_NOTICES.md" ]; then
        install -Dm644 "${srcdir}/THIRD_PARTY_NOTICES.md" \
            "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
    fi
}
